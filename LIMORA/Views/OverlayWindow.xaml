<Window x:Class="LIMORA.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight"
        Focusable="False" IsHitTestVisible="True" DataContext="{Binding}">
  <Border x:Name="Panel" Margin="2" Padding="13,7" CornerRadius="10"
          Background="{StaticResource PanelBrush}" BorderThickness="1"
          BorderBrush="{Binding CalibrationAccent}">
    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold"
               TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display"
               TextWrapping="NoWrap" ToolTip="{Binding Tooltip}" />
  </Border>
</Window>
