<Window x:Class="LIMORA.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIMORA settings" Icon="/LIMORA;component/Assets/limora.ico" Width="980" Height="680"
        MinWidth="860" MinHeight="660" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF18191D" Foreground="#FFF1F2F4"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#FF202228"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF343740"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFADB1BB"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#FF292C33"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#FF454953"/>

    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#FFE7E9ED"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
      <Setter Property="Foreground" Value="#FFF5F6F8"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="#FFF5F6F8"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
      <Setter Property="Foreground" Value="#FFF5F6F8"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="ComboBoxBorder" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
              <Grid Margin="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                <ToggleButton Grid.Column="1" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" CornerRadius="0,4,4,0">
                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFD5D8DE"
                              Width="8" Height="4" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
              </Grid>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                <Border x:Name="DropDownBorder" Background="#FF24262C" BorderBrush="#FF50545F"
                        BorderThickness="1" CornerRadius="4" MaxHeight="240" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#FF69707D"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#FF7BA8EB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboBoxBorder" Property="Background" Value="#FF24262B"/>
                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#FF3A3D45"/>
                <Setter Property="Foreground" Value="#FFB9BDC6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF24262C"/>
            <Setter Property="Foreground" Value="#FFF1F2F4"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}" CornerRadius="2" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="ItemBorder" Property="Background" Value="#FF34445B"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="ItemBorder" Property="Background" Value="#FF294A73"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Foreground" Value="#FFB9BDC6"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FFB9BDC6"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFE7E9ED"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5,0,5"/>
      <Setter Property="Padding" Value="4,2"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#FF9A9EA8"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#FFF5F6F8"/>
      <Setter Property="Background" Value="#FF30333B"/>
      <Setter Property="BorderBrush" Value="#FF4B4F5A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF3A3E48"/>
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF686D79"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF25272D"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FF315FA8"/>
      <Setter Property="BorderBrush" Value="#FF5D8DD7"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FF3D70C2"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FFF1F2F4"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFD0D3DA"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid Margin="26,20,26,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="LIMORA" FontSize="23" FontWeight="SemiBold" Foreground="#FFF7F8FA"/>
      <TextBlock Text="Local display and startup preferences" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Height="1" Background="#FF353840" Margin="0,16,0,14"/>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.12*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Display" Style="{StaticResource SectionTitleStyle}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Mode" Style="{StaticResource FieldLabelStyle}"/>
              <ComboBox x:Name="DisplayModeBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Text size (DIP)" Style="{StaticResource FieldLabelStyle}"/>
              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                <Slider x:Name="OverlayFontSizeSlider" Minimum="12" Maximum="24" TickFrequency="1"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnOverlayFontSizeChanged"/>
                <TextBlock x:Name="OverlayFontSizeValue" Grid.Column="1" HorizontalAlignment="Right"/>
              </Grid>
            </Grid>
            <CheckBox x:Name="ShowOverlayBox" Content="Show overlay beside Codex" Margin="0,12,0,0"/>
            <CheckBox x:Name="ShowResetTimeBox" Content="Show reset time in Detailed mode"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18" Margin="0">
          <StackPanel>
            <TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}"/>
            <RadioButton x:Name="AutomaticPositionRadio" GroupName="OverlayPosition" Content="Automatically beside the composer" Margin="0,0,0,5"/>
            <RadioButton x:Name="LeftPositionRadio" GroupName="OverlayPosition" Content="Left side of the Codex window" Margin="0,0,0,5"/>
            <RadioButton x:Name="RightPositionRadio" GroupName="OverlayPosition" Content="Right side of the Codex window" Margin="0,0,0,8"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Offset X (DIP)" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox x:Name="OffsetXBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Offset Y (DIP)" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox x:Name="OffsetYBox" Grid.Column="1"/>
            </Grid>
            <TextBlock Text="Choose left or right to place it manually. Use the tray's Calibrate position command to fine-tune its position by dragging."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Limits" Style="{StaticResource SectionTitleStyle}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Refresh interval (30–300s)" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox x:Name="RefreshIntervalBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Warning threshold (%)" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox x:Name="WarningThresholdBox" Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Critical threshold (%)" Style="{StaticResource FieldLabelStyle}"/>
              <TextBox x:Name="CriticalThresholdBox" Grid.Column="1"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18" Margin="0">
          <StackPanel>
            <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}"/>
            <CheckBox x:Name="StartWithWindowsBox" Content="Monitor for Codex when Windows starts (current user only)" Margin="0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#FFFF8F86" Margin="0,10,0,8" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Width="96" Margin="0,0,10,0" Click="OnCancel"/>
      <Button Content="Save" Width="96" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OnSave"/>
    </StackPanel>
  </Grid>
</Window>
