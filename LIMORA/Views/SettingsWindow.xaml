<Window x:Class="LIMORA.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIMORA settings" Width="430" Height="590" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FF202024" Foreground="#FFF0F0F2">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FF303035"/><Setter Property="Foreground" Value="#FFF2F2F4"/><Setter Property="BorderBrush" Value="#FF55555C"/><Setter Property="Padding" Value="7,4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#FF303035"/><Setter Property="Foreground" Value="#FFF2F2F4"/><Setter Property="Padding" Value="5"/></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,6,0,6"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="LIMORA" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,3"/>
      <TextBlock Text="Local display and startup preferences" Foreground="#FFAAAAB2"/>
    </StackPanel>
    <Separator Grid.Row="1" Margin="0,18,0,10"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="Display" FontWeight="SemiBold" Foreground="#FFB7B7C0" Margin="0,8,0,8"/>
      <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Mode"/><ComboBox x:Name="DisplayModeBox" Grid.Column="1"/>
      </Grid>
      <CheckBox x:Name="ShowOverlayBox" Content="Show overlay beside Codex"/>
      <CheckBox x:Name="ShowResetTimeBox" Content="Show reset countdown in Detailed mode"/>

      <TextBlock Text="Position" FontWeight="SemiBold" Foreground="#FFB7B7C0" Margin="0,16,0,8"/>
      <CheckBox x:Name="AutomaticPositionBox" Content="Find the composer automatically"/>
      <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Anchor"/><ComboBox x:Name="AnchorBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Offset X (DIP)"/><TextBox x:Name="OffsetXBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Offset Y (DIP)"/><TextBox x:Name="OffsetYBox" Grid.Column="1"/>
      </Grid>
      <TextBlock Text="Use the tray's Calibrate position command to drag the overlay." Foreground="#FFAAAAB2" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>

      <TextBlock Text="Limits" FontWeight="SemiBold" Foreground="#FFB7B7C0" Margin="0,16,0,8"/>
      <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Refresh interval (30–300s)"/><TextBox x:Name="RefreshIntervalBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Warning threshold (%)"/><TextBox x:Name="WarningThresholdBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Critical threshold (%)"/><TextBox x:Name="CriticalThresholdBox" Grid.Column="1"/>
      </Grid>
      <CheckBox x:Name="StartWithWindowsBox" Content="Start LIMORA with Windows (current user only)" Margin="0,14,0,0"/>
    </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#FFF28B82" Margin="0,9,0,8" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="86" Margin="0,0,10,0" Padding="8,6" Click="OnCancel"/>
      <Button Content="Save" Width="86" Padding="8,6" IsDefault="True" Click="OnSave"/>
    </StackPanel>
  </Grid>
</Window>
